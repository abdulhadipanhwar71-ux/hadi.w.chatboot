# Application Settings
DEBUG=True
HOST=127.0.0.1
PORT=8000

# SQLite Database (Auto-configured inside ./data)
DATABASE_URL=sqlite:///./data/bot_database.db

# WhatsApp Cloud API Credentials (from Meta Developers Portal)
# Leave blank to run in local offline/simulator mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my_secure_webhook_verify_token_123
WHATSAPP_API_VERSION=v18.0

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-to-a-secure-random-secret-key
